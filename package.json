{
  "name": "sistema-basilico-mvp",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema Basílico — PDV Offline-First & Hub de Delivery (MVP · ECOT11A/ECOT01 · UNIFEI)",
  "author": "Matheus Gouveia Purcino <2024006907>",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && npm run electron:compile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "electron:compile": "vite build --config vite.electron.config.ts",
    "electron:dev": "npm run electron:compile && concurrently -k -n VITE,ELECTRON -c green,cyan \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist:win": "npm run build && electron-builder --win nsis portable",
    "electron:dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "addon:build": "node-gyp rebuild --directory addons",
    "deploy:vercel": "npx vercel --prod",
    "deploy:gh-pages": "npm run build && npx gh-pages -d dist"
  },
  "build": {
    "appId": "br.edu.unifei.ecot11a.basilico",
    "productName": "Sistema Basilico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "addons/build/Release",
        "to": "addons",
        "filter": [
          "*.node"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
